# Plantilla de configuracion local. Copiar a .env y completar. NUNCA commitear .env.

# --- Base de datos (PostgreSQL 16+) ----------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/contabilidad
# Opcional: habilita los tests de contrato contra PostgreSQL (opt-in).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/contabilidad

# --- Aplicacion ------------------------------------------------------------
APP_NAME=ContabilidadV1
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000

# --- Autenticacion (JWT) ---------------------------------------------------
# Clave de firma de los tokens. **Obligatoria en produccion**: si falta, el
# backend genera un secreto aleatorio por proceso y avisa al arrancar (los
# tokens no sobreviven a un reinicio).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<64 caracteres hex, 256 bits>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
